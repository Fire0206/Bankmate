# Local development only. Never put real credentials or financial data here.
FINORCH_ENVIRONMENT=development
FINORCH_API_HOST=127.0.0.1
FINORCH_API_PORT=8000
FINORCH_SERVICE_NAME=finorch-api
FINORCH_SERVICE_VERSION=0.1.0
FINORCH_DATABASE_URL=sqlite:///./.data/finorch.db
# Local API demo starts a persistent reminder poller; tests and production keep it disabled.
FINORCH_SUBSCRIPTION_REMINDER_SCHEDULER_ENABLED=false
FINORCH_SUBSCRIPTION_REMINDER_SCHEDULER_INTERVAL_SECONDS=60
# Local deterministic simulation; no network call or API key is used by default.
FINORCH_AGENT_PROVIDER=fake
# External model requests are disabled unless explicitly enabled.
FINORCH_LLM_DATA_EGRESS_ENABLED=false
# Optional OpenAI-compatible model endpoint. Keep the key only in ignored .env.
# FINORCH_AGENT_PROVIDER=openai-compatible
# Enable only when sending synthetic requests to a trusted model provider.
# FINORCH_LLM_DATA_EGRESS_ENABLED=true
# DeepSeek Chat Completions tool-calling example:
# FINORCH_LLM_BASE_URL=https://api.deepseek.com
# FINORCH_LLM_API_KEY=
# FINORCH_LLM_MODEL=deepseek-flash
# FINORCH_LLM_TIMEOUT_SECONDS=60
# Low sampling temperature for steadier tool selection; range is 0 to 2.
# FINORCH_LLM_TEMPERATURE=0.2
# Server-selected synthetic actor. Never accept a user ID from the browser.
FINORCH_DEMO_USER_ID=00000000-0000-4000-8000-000000000001
