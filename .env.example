# Local development only. Never put real credentials or financial data here.
BANKMATE_ENVIRONMENT=development
BANKMATE_API_HOST=127.0.0.1
BANKMATE_API_PORT=8000
BANKMATE_SERVICE_NAME=bankmate-api
BANKMATE_SERVICE_VERSION=0.1.0
BANKMATE_DATABASE_URL=sqlite:///./.data/bankmate.db
# Local API demo starts a persistent reminder poller; tests and production keep it disabled.
BANKMATE_SUBSCRIPTION_REMINDER_SCHEDULER_ENABLED=false
BANKMATE_SUBSCRIPTION_REMINDER_SCHEDULER_INTERVAL_SECONDS=60
# Local deterministic simulation; no network call or API key is used by default.
BANKMATE_AGENT_PROVIDER=fake
# External model requests are disabled unless explicitly enabled.
BANKMATE_LLM_DATA_EGRESS_ENABLED=false
# Optional OpenAI-compatible model endpoint. Keep the key only in ignored .env.
# BANKMATE_AGENT_PROVIDER=openai-compatible
# Enable only when sending synthetic requests to a trusted model provider.
# BANKMATE_LLM_DATA_EGRESS_ENABLED=true
# DeepSeek Chat Completions tool-calling example:
# BANKMATE_LLM_BASE_URL=https://api.deepseek.com
# BANKMATE_LLM_API_KEY=
# BANKMATE_LLM_MODEL=deepseek-flash
# BANKMATE_LLM_TIMEOUT_SECONDS=60
# Low sampling temperature for steadier tool selection; range is 0 to 2.
# BANKMATE_LLM_TEMPERATURE=0.2
# Server-selected synthetic actor. Never accept a user ID from the browser.
BANKMATE_DEMO_USER_ID=00000000-0000-4000-8000-000000000001
# Optional fixed business date for the recorded showcase dataset.
# BANKMATE_DEMO_NOW=2026-10-28T12:00:00+00:00
